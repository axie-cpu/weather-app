{
  "name": "atmosphere-weather",
  "private": true,
  "version": "1.2.2",
  "type": "module",
  "scripts": {
    "dev": "cp index.vite.html index.html && vite",
    "build": "node scripts/pack-widget.mjs && cp index.vite.html index.html && vite build && node scripts/publish-static.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "pin-atmosphere": "npm --prefix desktop run pin-atmosphere"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "vite": "^6.3.5"
  }
}
